#include<bits/stdc++.h>
using namespace std;
int n=9;
vector<vector<int>>grid(n, vector<int>(n));
bool isSafe(int row,  int col, int num)
{
    for(int i=0;i<n;i++)
    {
        if(grid[row][i]==num || grid[i][col]==num)
        return false;
    }
    int rowChange=row-row%3;
    int colChange=col-col%3;
    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            if(grid[rowChange+i][colChange+j]==num)
            return false;
        }
    }
    return true;
}
bool solveGrid()
{
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            if(grid[i][j]==0)
            {
                for(int num=1;num<=9;num++)
                {
                    if(isSafe(i,j,num))
                    {
                        grid[i][j]=num;
                        if(solveGrid())
                        return true;
                        grid[i][j]=0;
                    }
                }
                return false;
                
            }
        }
    }
    return true;
}
int main()
{
    for(int i=0;i<9;i++)
    {
        for(int j=0;j<9;j++)
        {
            cin>>grid[i][j];
        }
    }
    if(solveGrid())
    {
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<n;j++)
            {
                cout<<grid[i][j]<<" ";
            }
            cout<<endl;
        }
    }
    else
    {
        cout<<"No Solution exists";
    }
}
